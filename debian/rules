#!/usr/bin/make -f

# Mod source data (localisation yml files and generated fonts) is not
# stored in this repository. At build time it is copied from a local
# eu4dll_translations mod directory. Point EU4DLL_MOD_SRC at that
# directory; the default is the Paradox user mod directory of the
# user running the build.
EU4DLL_MOD_SRC ?= $(HOME)/.local/share/Paradox Interactive/Europa Universalis IV/mod/eu4dll_translations

PKG := debian/eu4dll
LIBDIR := usr/lib/eu4dll

# Directory holding the shared D runtime libraries of the ldc2 in
# use. The runtime is bundled into the package (see the install
# target), so the installed library does not depend on whatever D
# runtime the system happens to have.
LDC_LIB_DIR := $(abspath $(dir $(shell command -v ldc2))/../lib)

%:
	dh $@

override_dh_auto_build:
	# The source needs LDC >= 1.43 (naked asm form). Fail early with
	# a readable message instead of a link error.
	@ver=$$(ldc2 --version | sed -n 's/.*(\([0-9][0-9.]*\)):/\1/p' | head -n 1); \
	if [ -z "$$ver" ] || [ "$$(printf '1.43.0\n%s\n' "$$ver" | sort -V | head -n 1)" != "1.43.0" ]; then \
		echo "error: LDC >= 1.43.0 is required to build eu4dll (found: $${ver:-unknown})." >&2; \
		echo "Debian's ldc package is older. Extract the official LDC 1.43 release and put its bin directory first on PATH." >&2; \
		exit 1; \
	fi
	# dpkg-buildflags exports a DFLAGS value that ldc2 rejects
	# (-frelease), so build with it cleared.
	DFLAGS= dub build --force --compiler=ldc2

override_dh_auto_test:
	# Upstream tests are run with "make test" during development.
	# They are skipped during the package build.

override_dh_auto_install:
	# Preload library
	install -D -m 0644 libeu4dll.so $(PKG)/$(LIBDIR)/libeu4dll.so
	# Bundled D runtime from the compiler in use
	for lib in libphobos2-ldc-shared libdruntime-ldc-shared; do \
		real=$$(readlink -f "$(LDC_LIB_DIR)/$$lib.so"); \
		soname=$$(objdump -p "$$real" | awk '/SONAME/ {print $$2}'); \
		echo "bundling $$soname from $$real"; \
		install -m 0644 "$$real" "$(PKG)/$(LIBDIR)/$$soname"; \
	done
	patchelf --set-rpath '$$ORIGIN' $(PKG)/$(LIBDIR)/libeu4dll.so
	# Helper scripts
	install -D -m 0755 debian/scripts/eu4dll-launch $(PKG)/usr/bin/eu4dll-launch
	install -D -m 0755 debian/scripts/eu4dll-install-mod $(PKG)/usr/bin/eu4dll-install-mod
	# Mod data
	test -d "$(EU4DLL_MOD_SRC)/localisation" || { echo "EU4DLL_MOD_SRC=$(EU4DLL_MOD_SRC): localisation/ not found. Set EU4DLL_MOD_SRC to a eu4dll_translations mod directory."; exit 1; }
	test -d "$(EU4DLL_MOD_SRC)/gfx/fonts" || { echo "EU4DLL_MOD_SRC=$(EU4DLL_MOD_SRC): gfx/fonts/ not found. Set EU4DLL_MOD_SRC to a eu4dll_translations mod directory."; exit 1; }
	# The adopted fonts are the delta3 set (raster size reduced by 3 px;
	# see memory-bank/details/font_size_survey.md section 7). Check the
	# info size of every font against the delta3 table and stop the
	# build if any font is not delta3.
	@for spec in \
		"Arial12 11" "garamond_12 9" "garamond_14 11" \
		"garamond_14_bold 11" "garamond_16 13" "garamond_16_bold 13" \
		"garamond_24 21" "standard 15" "standard_18 15" \
		"standard_22 19" "vic_18 15" "vic_18_grey 15" \
		"vic_22 19" "vic_22_bl 19" "vic_29 26" "vic_36 33"; do \
		name=$${spec% *}; want=$${spec#* }; \
		fnt="$(EU4DLL_MOD_SRC)/gfx/fonts/$$name.fnt"; \
		got=$$(sed -n "s/^info .*size=\([0-9][0-9]*\).*/\1/p" "$$fnt" | head -n 1); \
		if [ "$$got" != "$$want" ]; then \
			echo "error: $$name.fnt has info size $${got:-unknown}, expected $$want (delta3)." >&2; \
			echo "The packaged fonts must be the delta3 set. Regenerate them with tools/generate_fonts.py and try again." >&2; \
			exit 1; \
		fi; \
	done; \
	echo "font check: all 16 fonts match the delta3 info sizes."
	# The bundled Mapfont is the outlined set generated by
	# tools/generate_mapfont.py. The unoutlined set has a 4096x8192
	# atlas while the outlined set has 8192x4912, so check for the
	# files and the atlas size in the common line to catch a mix-up.
	@test -f "$(EU4DLL_MOD_SRC)/gfx/fonts/Mapfont.fnt" || { echo "error: Mapfont.fnt not found in $(EU4DLL_MOD_SRC)/gfx/fonts." >&2; echo "The packaged Mapfont must be the outlined set. Generate it with tools/generate_mapfont.py and place Mapfont.fnt and Mapfont.dds there." >&2; exit 1; }
	@test -f "$(EU4DLL_MOD_SRC)/gfx/fonts/Mapfont.dds" || { echo "error: Mapfont.dds not found in $(EU4DLL_MOD_SRC)/gfx/fonts." >&2; echo "The packaged Mapfont must be the outlined set. Generate it with tools/generate_mapfont.py and place Mapfont.fnt and Mapfont.dds there." >&2; exit 1; }
	@scalew=$$(sed -n "s/^common .*scaleW=\([0-9][0-9]*\).*/\1/p" "$(EU4DLL_MOD_SRC)/gfx/fonts/Mapfont.fnt" | head -n 1); \
	scaleh=$$(sed -n "s/^common .*scaleH=\([0-9][0-9]*\).*/\1/p" "$(EU4DLL_MOD_SRC)/gfx/fonts/Mapfont.fnt" | head -n 1); \
	if [ "$$scalew" != "8192" ] || [ "$$scaleh" != "4912" ]; then \
		echo "error: Mapfont.fnt has atlas size $${scalew:-unknown}x$${scaleh:-unknown}, expected 8192x4912 (outlined)." >&2; \
		echo "The packaged Mapfont must be the outlined set. Regenerate it with tools/generate_mapfont.py and try again." >&2; \
		exit 1; \
	fi; \
	echo "font check: Mapfont is the outlined set (atlas 8192x4912)."
	install -d $(PKG)/usr/share/eu4dll/mod/eu4dll_translations/localisation
	install -m 0644 "$(EU4DLL_MOD_SRC)"/localisation/*.yml $(PKG)/usr/share/eu4dll/mod/eu4dll_translations/localisation/
	install -d $(PKG)/usr/share/eu4dll/mod/eu4dll_translations/gfx/fonts
	install -m 0644 "$(EU4DLL_MOD_SRC)"/gfx/fonts/* $(PKG)/usr/share/eu4dll/mod/eu4dll_translations/gfx/fonts/
	install -D -m 0644 debian/eu4dll_translations.mod $(PKG)/usr/share/eu4dll/mod/eu4dll_translations.mod

override_dh_shlibdeps:
	# The bundled D runtime has no Debian shlibs information; the
	# package is self-contained, so do not turn it into Depends.
	dh_shlibdeps -l$(CURDIR)/$(PKG)/$(LIBDIR) --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_auto_clean:
	dub clean || true
	rm -f libeu4dll.so
	dh_auto_clean
